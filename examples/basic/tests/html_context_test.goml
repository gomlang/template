package tests;

use ecosystem::template;
use std::testing;

#[test]
fn contextual_html_consumer_url_and_script() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    testing::expect_ok(
        engine.add("page", "<a href=\"{{url}}\">{{label}}</a><script>let x={{label}};</script>"),
        "page",
    );
    let context = template::Value::Object(
        Vec::from_array(
            [
                ("url", template::Value::Text("https://example.test/?a=1&b=2")),
                ("label", template::Value::Safe("</script><b>")),
            ],
        ),
    );
    testing::assert_eq(
        testing::expect_ok(engine.render_html("page", context), "contextual render"),
        "<a href=\"https://example.test/?a=1&amp;b=2\">&lt;/script&gt;&lt;b&gt;</a><script>let x=\"\\u003c\\u002fscript\\u003e\\u003cb\\u003e\";</script>",
    );
}

#[test]
fn contextual_html_consumer_form_feed_keeps_raw_element_context() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    testing::expect_ok(engine.add("value", "{{x}}"), "value");
    testing::expect_ok(
        engine.add("page", "<script\f>let x={% include 'value' %};</script>"),
        "page",
    );
    let context = template::Value::Object(
        Vec::from_array([("x", template::Value::Text("alert(1)"))]),
    );
    testing::assert_eq(
        testing::expect_ok(engine.render_html("page", context), "script with form feed"),
        "<script\f>let x=\"alert(1)\";</script>",
    );
}

#[test]
fn contextual_html_consumer_raw_close_with_whitespace_restores_text_escaping() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    let context = template::Value::Object(Vec::from_array([("x", template::Value::Text("a&b"))]));
    testing::assert_eq(
        testing::expect_ok(
            engine.render_html_string("<script></script\t><p>{{x}}</p>", context),
            "raw closing tag with whitespace",
        ),
        "<script></script\t><p>a&amp;b</p>",
    );
}

#[test]
fn contextual_html_consumer_interpolation_breaks_partial_literal_delimiters() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    let context = template::Value::Object(Vec::from_array([("x", template::Value::Text("MARK"))]));
    testing::assert_eq(
        testing::expect_ok(
            engine.render_html_string("<script><{{x}}/script>{{x}}</script>", context),
            "interpolation prevents a closing tag",
        ),
        "<script><\"MARK\"/script>\"MARK\"</script>",
    );
}
