package tests;

use ecosystem::template::examples::basic as example;
use ecosystem::template;
use std::testing;

#[test]
fn downstream_serde_context_callbacks_and_inheritance() -> () {
    testing::assert_ok(example::exercise());
}

#[test]
fn reusable_compiled_template_keeps_render_scopes_separate() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    let compiled = testing::expect_ok(
        template::compile("shared", "{% set x=x+1 %}{{x}}"),
        "compile",
    );
    let context = template::Value::Object(Vec::from_array([("x", template::Value::Int(1))]));
    for _ in 0..3 {
        testing::assert_eq(
            testing::expect_ok(engine.render_template(compiled, context), "render"),
            "2",
        );
    }
    testing::assert(context.get("x").as_int() == Option::Some(1));
}

#[test]
fn downstream_sort_by_attribute() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    let source = "{% for row in [{'name':'B','rank':2},{'name':'A','rank':1}]|sort(false, 'rank') %}{{row.name}}{% endfor %}";
    testing::assert_eq(
        testing::expect_ok(
            engine.render_string(source, template::Value::Object(Vec::new())),
            "attribute sort",
        ),
        "AB",
    );
}

#[test]
fn downstream_floating_remainder_handles_large_operands() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    testing::assert_eq(
        testing::expect_ok(
            engine.render_string(
                "{{ 1e308 % 3.0 }}|{{ -1e20 % 3.0 }}|{{ 1e308 % 0.1 == 0.06093288384329992 }}",
                template::Value::Object(Vec::new()),
            ),
            "floating remainder",
        ),
        "2|2|true",
    );
}
