package tests;

use ecosystem::template;
use std::testing;

#[test]
fn downstream_json_escapes_do_not_change_safe_markup() -> () {
    let engine = testing::expect_ok(template::Engine::new(template::Options::standard()), "engine");
    let context = template::Value::Object(
        Vec::from_array([("value", template::Value::Text("<\n界"))]),
    );
    testing::assert_eq(
        testing::expect_ok(engine.render_string("{{ value|tojson }}", context), "JSON"),
        "\"\\u003c\\n界\"",
    );
}
