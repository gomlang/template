package tests;

use ecosystem::template;
use ecosystem::template::{Engine, ErrorKind, Options, Value};
use std::testing;

fn html_engine() -> Engine {
    testing::expect_ok(Engine::new(Options::standard()), "HTML template engine")
}

fn html_context(value: string) -> Value {
    Value::Object(Vec::from_array([("x", Value::Text(value))]))
}

fn html_render(source: string, value: string) -> string {
    testing::expect_ok(html_engine().render_html_string(source, html_context(value)), "HTML render")
}

#[test]
fn contextual_html_text_attributes_and_urls() -> () {
    testing::assert_eq(html_render("<p>{{x}}</p>", "<&'\""), "<p>&lt;&amp;&#39;&#34;</p>");
    testing::assert_eq(html_render("1 < 2; {{x}}", "<"), "1 < 2; &lt;");
    testing::assert_eq(
        html_render("<p title=\"{{x}}\">x</p>", "a\" < b"),
        "<p title=\"a&#34; &lt; b\">x</p>",
    );
    testing::assert_eq(
        html_render("<p title={{x}}>x</p>", "a b=c`d"),
        "<p title=a&#32;b&#61;c&#96;d>x</p>",
    );
    testing::assert_eq(
        html_render("<a href=\"{{x}}\">x</a>", "https://example.test/?a=1&b=2"),
        "<a href=\"https://example.test/?a=1&amp;b=2\">x</a>",
    );
    testing::assert_eq(
        html_render("<a href=\"/user/{{x}}\">x</a>", "a/b?x=<"),
        "<a href=\"/user/a%2Fb%3Fx%3D%3C\">x</a>",
    );
}

#[test]
fn contextual_script_style_and_trust_markers() -> () {
    testing::assert_eq(
        html_render("<script>let x={{x}};</script>", "</script><img src=x>"),
        "<script>let x=\"\\u003c\\u002fscript\\u003e\\u003cimg src=x\\u003e\";</script>",
    );
    testing::assert_eq(
        html_render("<script/>{{x}}</script>", "alert(1)"),
        "<script/>\"alert(1)\"</script>",
    );
    testing::assert_eq(
        html_render("<style>.x{content:{{x}}}</style>", "</style>"),
        "<style>.x{content:\"\\3c \\2f style\\3e \"}</style>",
    );
    testing::assert_eq(
        html_render("<style/>.x{content:{{x}}}</style>", "</style>"),
        "<style/>.x{content:\"\\3c \\2f style\\3e \"}</style>",
    );
    testing::assert_eq(html_render("{{x|safe}}", "<b>"), "&lt;b&gt;");
    testing::assert_eq(
        html_render("{% autoescape false %}{{x}}{% endautoescape %}", "<b>"),
        "&lt;b&gt;",
    );
}

#[test]
fn contextual_raw_elements_accept_all_html_whitespace_after_the_tag_name() -> () {
    for separator in["\f", " ", "\t", "\n", "\r"] {
        let script = "<ScRiPt" + separator + "data-kind='value'>let x=";
        testing::assert_eq(
            html_render(script + "{{x}};</ScRiPt>", "alert(1)"),
            script + "\"alert(1)\";</ScRiPt>",
        );
        let style = "<StYlE" + separator + ">.x{content:";
        testing::assert_eq(
            html_render(style + "{{x}}}</StYlE>", "red; color: blue"),
            style + "\"red; color: blue\"}</StYlE>",
        );
    }
    for name in["scripture", "stylesheet", "script\u00a0", "style\u000b"] {
        let opening = "<" + name + ">";
        let closing = "</" + name + ">";
        testing::assert_eq(
            html_render(opening + "{{x}}" + closing, "a&b"),
            opening + "a&amp;b" + closing,
        );
    }
}

#[test]
fn contextual_raw_elements_with_form_feed_keep_string_and_comment_guards() -> () {
    for source in[
        "<script\f>let x='{{x}}';</script>",
        "<script\f>// {{x}}\n</script>",
        "<style\f>.x{content:'{{x}}'}</style>",
        "<style\f>/* {{x}} */</style>",
    ] {
        let error = testing::expect_err(
            html_engine().render_html_string(source, html_context("value")),
            "unsupported raw string or comment context",
        );
        testing::assert_eq(error.kind, ErrorKind::Type);
    }
}

#[test]
fn contextual_raw_closing_tags_accept_html_delimiters_before_returning_to_text() -> () {
    for (opening, name) in[
        ("<script>", "script"),
        ("<style>", "style"),
        ("<ScRiPt>let value='", "ScRiPt"),
        ("<style>/* comment", "StYlE"),
    ] {
        for suffix in[
            " >",
            "\t>",
            "\n>",
            "\f>",
            "\r>",
            "/>",
            " data-kind='>'>",
            " data-kind=value>",
            "\t".repeat(80) + ">",
        ] {
            let literal = opening + "</" + name + suffix;
            testing::assert_eq(
                html_render(literal + "<p>{{x}}</p>", "a&b"),
                literal + "<p>a&amp;b</p>",
            );
        }
    }
    for name in["scriptx", "script\u00a0", "script\u000b"] {
        let literal = "<script></" + name + ">";
        testing::assert_eq(
            html_render(literal + "{{x}}</script>", "a&b"),
            literal + "\"a\\u0026b\"</script>",
        );
    }
}

#[test]
fn contextual_raw_closing_tags_track_literal_boundaries_and_reject_dynamic_tag_content() -> () {
    let engine = html_engine();
    testing::expect_ok(engine.add("name", "ipt"), "closing name fragment");
    testing::expect_ok(engine.add("space", " ".repeat(80)), "closing whitespace fragment");
    testing::expect_ok(
        engine.add("page", "<script></scr{% include 'name' %}{% include 'space' %}><p>{{x}}</p>"),
        "fragmented closing tag",
    );
    testing::assert_eq(
        testing::expect_ok(engine.render_html("page", html_context("a&b")), "fragmented close"),
        "<script></script" + " ".repeat(80) + "><p>a&amp;b</p>",
    );
    for source in[
        "<script></script {{x}}>",
        "<script></script data-kind='{{x}}'>",
        "<style></style/{{x}}>",
        "<style></style data-kind={{x}}>",
    ] {
        let error = testing::expect_err(
            html_engine().render_html_string(source, html_context("value")),
            "dynamic closing tag content",
        );
        testing::assert_eq(error.kind, ErrorKind::Type);
    }
}

#[test]
fn contextual_raw_partial_closing_names_reject_interpolation() -> () {
    for name in["script", "style"] {
        for index in 0..name.byte_len() + 1 {
            let source = "<" + name + ">BODY</" + name.byte_slice(0, index) + "{{x}}"
                + name.byte_slice(index, name.byte_len())
                + ">AFTER{{x}}</"
                + name
                + ">";
            let error = testing::expect_err(
                html_engine().render_html_string(source, html_context("MARK")),
                "dynamic closing tag name",
            );
            testing::assert_eq(error.kind, ErrorKind::Type);
        }
    }
}

#[test]
fn contextual_raw_interpolations_interrupt_literal_tag_and_comment_prefixes() -> () {
    for name in["script", "style"] {
        for value in["MARK", ""] {
            let source = "<" + name + "><{{x}}/" + name + ">{{x}}</" + name + ">";
            let quoted = "\"" + value + "\"";
            testing::assert_eq(
                html_render(source, value),
                "<" + name + "><" + quoted + "/" + name + ">" + quoted + "</" + name + ">",
            );
        }
    }
    let context = Value::Object(Vec::from_array([("x", Value::Int(2))]));
    for operation in["/", "*"] {
        testing::assert_eq(
            testing::expect_ok(
                html_engine().render_html_string(
                    "<script>let a=8/{{x}}" + operation + "2; let b=1<{{x}};</script>",
                    context,
                ),
                "JavaScript arithmetic around interpolation",
            ),
            "<script>let a=8/2" + operation + "2; let b=1<2;</script>",
        );
    }
    let comparison = Value::Object(
        Vec::from_array([("x", Value::Int(4)), ("y", Value::Text("MARK<&>"))]),
    );
    testing::assert_eq(
        testing::expect_ok(
            html_engine().render_html_string(
                "<script>let script=2;let result=1<{{x}}/script>0;let text={{y}};</script>",
                comparison,
            ),
            "comparison followed by division remains inside script",
        ),
        "<script>let script=2;let result=1<4/script>0;let text=\"MARK\\u003c\\u0026\\u003e\";</script>",
    );
}

#[test]
fn contextual_rejects_unsafe_or_ambiguous_positions() -> () {
    for source in["<a href=\"{{x}}\">x</a>", "<img src=\"{{x}}\">"] {
        for value in["javascript:alert(1)", "data:text/html,boom", " javaScript:alert(1)"] {
            let error = testing::expect_err(
                html_engine().render_html_string(source, html_context(value)),
                "unsafe URL",
            );
            testing::assert_eq(error.kind, ErrorKind::Type);
        }
    }
    for (source, value) in[
        ("<a href=\"{{x}}:alert(1)\">x</a>", "javascript"),
        ("<a href=\"java{{x}}:alert(1)\">x</a>", "script"),
    ] {
        let error = testing::expect_err(
            html_engine().render_html_string(source, html_context(value)),
            "assembled unsafe URL",
        );
        testing::assert_eq(error.kind, ErrorKind::Type);
    }
    for source in[
        "<{{x}}>bad</p>",
        "<p {{x}}=v></p>",
        "<!-- {{x}} -->",
        "<p onclick=\"{{x}}\"></p>",
        "<p style=\"{{x}}\"></p>",
        "<p srcset=\"{{x}}\"></p>",
        "<iframe srcdoc=\"{{x}}\"></iframe>",
        "<meta content=\"{{x}}\">",
        "<script>let x='{{x}}';</script>",
        "<style>.x{content:'{{x}}'}</style>",
    ] {
        let error = testing::expect_err(
            html_engine().render_html_string(source, html_context("<unsafe>")),
            "unsupported HTML context",
        );
        testing::assert_eq(error.kind, ErrorKind::Type);
    }
    let error = testing::expect_err(
        html_engine().render_html_string("<a href=\"{{x}}", html_context("/ok")),
        "unfinished HTML",
    );
    testing::assert_eq(error.kind, ErrorKind::Syntax);
}

#[test]
fn contextual_includes_follow_the_actual_output_context() -> () {
    let engine = html_engine();
    testing::expect_ok(engine.add("child", "{{x}}"), "add child");
    testing::expect_ok(
        engine.add("page", "<a href=\"/user/{% include 'child' %}\">x</a>"),
        "add page",
    );
    testing::assert_eq(
        testing::expect_ok(engine.render_html("page", html_context("a/b")), "include URL"),
        "<a href=\"/user/a%2Fb\">x</a>",
    );
    testing::assert_eq(
        html_render(
            "<a {% if true %}href=\"/user/{{x}}\"{% else %}title=\"{{x}}\"{% endif %}>x</a>",
            "a/b",
        ),
        "<a href=\"/user/a%2Fb\">x</a>",
    );
}

#[test]
fn contextual_expansion_respects_output_limit() -> () {
    let options = Options {
        strict_undefined: true,
        autoescape: true,
        limits: template::Limits { max_output_bytes: 32, ..template::Limits::standard() },
    };
    let engine = testing::expect_ok(Engine::new(options), "limited HTML engine");
    let error = testing::expect_err(
        engine.render_html_string("<p title=\"{{x}}\"></p>", html_context("&&&&&&&&")),
        "attribute expansion limit",
    );
    testing::assert_eq(error.kind, ErrorKind::Limit);
}
