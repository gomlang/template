package tests;

use ecosystem::template::{Engine, Options, Value};
use std::testing;

#[test]
fn floating_absolute_value_clears_negative_zero_and_preserves_magnitude() -> () {
    let engine = testing::expect_ok(Engine::new(Options::standard()), "engine");
    testing::assert_ok(
        engine.register_filter(
            "bits",
            |value, _| match value {
                Value::Float(number) => Result::Ok(Value::Text(number.to_bits().to_string())),
                _ => Result::Err("expected float"),
            },
        ),
    );
    for (input, expected) in[
        (float64_from_bits(0x8000000000000000), 0.0),
        (0.0, 0.0),
        (-5e-324, 5e-324),
        (-3.5, 3.5),
        (3.5, 3.5),
        (-1.7976931348623157e308, 1.7976931348623157e308),
    ] {
        testing::assert_eq(
            testing::expect_ok(
                engine.render_string(
                    "{{ value|abs|bits }}",
                    Value::Object(Vec::from_array([("value", Value::Float(input))])),
                ),
                "absolute value",
            ),
            expected.to_bits().to_string(),
        );
    }
}
