package template;

use std::unicode;

struct HtmlContext {
    mode: isize,
    tag: Vec[byte],
    quote: byte,
    tail: string,
    raw_quote: byte,
    raw_escape: bool,
    raw_comment: isize,
    raw_previous: byte,
}

impl HtmlContext {
    fn new() -> HtmlContext {
        HtmlContext {
            mode: 0,
            tag: Vec::new(),
            quote: 0,
            tail: "",
            raw_quote: 0,
            raw_escape: false,
            raw_comment: 0,
            raw_previous: 0,
        }
    }

    fn feed(self: HtmlContext, literal: string, limit: isize, source: Source, offset: isize) -> Result[
        HtmlContext,
        Error,
    ] {
        let mut state = self;
        for byte in literal.to_bytes() {
            if state.mode == 0 {
                if byte == b'<' {
                    state.mode = 1;
                    state.tag = Vec::from_array([byte]);
                    state.quote = 0;
                }
                continue;
            }
            if state.mode == 1 {
                if state.tag.len() >= limit {
                    return Result::Err(
                        problem(source, offset, ErrorKind::Limit, "HTML tag exceeds output limit"),
                    )
                }
                state.tag.push(byte);
                if state.tag.len() == 2
                    && !((byte >= b'A' && byte <= b'Z') || (byte >= b'a' && byte <= b'z')
                        || byte == b'/'
                        || byte == b'!'
                        || byte == b'?') {
                    state.mode = 0;
                    state.tag = Vec::new();
                    continue;
                }
                if state.tag.len() == 4 && string_from_utf8(state.tag.copy()).1 == "<!--" {
                    state.mode = 2;
                    state.tail = "<!--";
                    state.tag = Vec::new();
                    continue;
                }
                if state.quote == 0 {
                    if byte == b'"' || byte == b'\'' {
                        state.quote = byte;
                    } else if byte == b'>' {
                        let tag = string_from_utf8(state.tag.copy()).1.to_ascii_lowercase();
                        if !safe_url_attributes(tag) {
                            return Result::Err(
                                problem(source, offset, ErrorKind::Type, "unsafe URL attribute"),
                            )
                        }
                        state.mode = if raw_open(tag, "script") {
                            3
                        } else if raw_open(tag, "style") {
                            4
                        } else {
                            0
                        };
                        state.tag = Vec::new();
                        state.tail = "";
                        state.raw_quote = 0;
                        state.raw_escape = false;
                        state.raw_comment = 0;
                        state.raw_previous = 0;
                    }
                } else if byte == state.quote {
                    state.quote = 0;
                }
                continue;
            }
            let current = if byte < 128 {
                char_from_u32(byte.to_u32()).unwrap_or('?').to_string().to_ascii_lowercase()
            } else {
                "?"
            };
            state.tail += current;
            if state.tail.byte_len() > 32 {
                state.tail = state.tail.byte_slice(
                    state.tail.byte_len() - 32,
                    state.tail.byte_len(),
                );
            }
            if state.mode == 2 {
                if state.tail.ends_with("-->") {
                    state.mode = 0;
                    state.tail = "";
                }
                continue;
            }
            if (state.mode == 3 && state.tail.ends_with("</script>"))
                || (state.mode == 4 && state.tail.ends_with("</style>")) {
                state.mode = 0;
                state.tail = "";
                state.raw_quote = 0;
                state.raw_comment = 0;
                state.raw_previous = 0;
                continue;
            }
            if state.raw_comment == 1 {
                if byte == b'\n' || byte == b'\r' {
                    state.raw_comment = 0;
                }
            } else if state.raw_comment == 2 {
                if state.raw_previous == b'*' && byte == b'/' {
                    state.raw_comment = 0;
                }
            } else if state.raw_quote != 0 {
                if state.raw_escape {
                    state.raw_escape = false;
                } else if byte == b'\\' {
                    state.raw_escape = true;
                } else if byte == state.raw_quote {
                    state.raw_quote = 0;
                }
            } else if state.raw_previous == b'/' && byte == b'/' && state.mode == 3 {
                state.raw_comment = 1;
            } else if state.raw_previous == b'/' && byte == b'*' {
                state.raw_comment = 2;
            } else if byte == b'"' || byte == b'\'' || (byte == b'`' && state.mode == 3) {
                state.raw_quote = byte;
            }
            state.raw_previous = byte;
        }
        Result::Ok(state)
    }
}

fn raw_open(tag: string, name: string) -> bool {
    let prefix = "<" + name;
    if !tag.starts_with(prefix) || tag.byte_len() <= prefix.byte_len() {
        return false
    }
    let next = tag.byte_get(prefix.byte_len());
    next == b'>' || next == b'/' || next == b' ' || next == b'\t' || next == b'\n' || next == b'\r'
}

struct HtmlSlot {
    attribute: string,
    prefix: string,
    bare: bool,
}

fn html_space(value: byte) -> bool {
    value == b' ' || value == b'\t' || value == b'\n' || value == b'\r' || value == 12
}

fn html_slot(tag: string) -> Option[HtmlSlot] {
    let length = tag.byte_len();
    let mut index = 1;
    if index < length && (tag.byte_get(index) == b'!' || tag.byte_get(index) == b'?') {
        return Option::None
    }
    if index < length && tag.byte_get(index) == b'/' {
        return Option::None
    }
    let name_start = index;
    while index < length && !html_space(tag.byte_get(index)) && tag.byte_get(index) != b'/' {
        index += 1;
    }
    if index == name_start || index == length {
        return Option::None
    }
    while index < length {
        while index < length && html_space(tag.byte_get(index)) {
            index += 1;
        }
        if index == length || tag.byte_get(index) == b'/' {
            return Option::None
        }
        let start = index;
        while index < length && !html_space(tag.byte_get(index)) && tag.byte_get(index) != b'=' {
            index += 1;
        }
        if index == start || index == length {
            return Option::None
        }
        let attribute = tag.byte_slice(start, index).to_ascii_lowercase();
        while index < length && html_space(tag.byte_get(index)) {
            index += 1;
        }
        if index == length || tag.byte_get(index) != b'=' {
            continue;
        }
        index += 1;
        while index < length && html_space(tag.byte_get(index)) {
            index += 1;
        }
        if index == length {
            return Option::Some(HtmlSlot { attribute, prefix: "", bare: true })
        }
        let quote = tag.byte_get(index);
        if quote == b'"' || quote == b'\'' {
            index += 1;
            let start = index;
            while index < length && tag.byte_get(index) != quote {
                index += 1;
            }
            if index == length {
                return Option::Some(
                    HtmlSlot { attribute, prefix: tag.byte_slice(start, index), bare: false },
                )
            }
            index += 1;
        } else {
            let start = index;
            while index < length && !html_space(tag.byte_get(index)) {
                index += 1;
            }
            if index == length {
                return Option::Some(
                    HtmlSlot { attribute, prefix: tag.byte_slice(start, index), bare: true },
                )
            }
        }
    }
    Option::None
}

fn url_attribute(name: string) -> bool {
    name == "href" || name == "src" || name == "action" || name == "formaction" || name == "poster"
        || name == "cite"
        || name == "background"
        || name == "data"
        || name == "xlink:href"
}

fn safe_url(value: string) -> bool {
    for scalar in value.chars() {
        if unicode::is_whitespace(scalar) || scalar.to_u32() < 33 || scalar == '\\' {
            return false
        }
    }
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'/' || byte == b'?' || byte == b'#' {
            return true
        }
        if byte == b'&' {
            return false
        }
        if byte == b':' {
            let scheme = value.byte_slice(0, index).to_ascii_lowercase();
            return scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel"
        }
        index += 1;
    }
    true
}

fn safe_url_attributes(tag: string) -> bool {
    let length = tag.byte_len();
    let mut index = 1;
    if index < length
        && (tag.byte_get(index) == b'/' || tag.byte_get(index) == b'!'
            || tag.byte_get(index) == b'?') {
        return true
    }
    while index < length && !html_space(tag.byte_get(index)) && tag.byte_get(index) != b'>' {
        index += 1;
    }
    while index < length {
        while index < length && (html_space(tag.byte_get(index)) || tag.byte_get(index) == b'/') {
            index += 1;
        }
        if index >= length || tag.byte_get(index) == b'>' {
            return true
        }
        let start = index;
        while index < length && !html_space(tag.byte_get(index)) && tag.byte_get(index) != b'='
            && tag.byte_get(index) != b'>' {
            index += 1;
        }
        if index == start {
            return false
        }
        let attribute = tag.byte_slice(start, index);
        while index < length && html_space(tag.byte_get(index)) {
            index += 1;
        }
        if index >= length || tag.byte_get(index) != b'=' {
            continue
        }
        index += 1;
        while index < length && html_space(tag.byte_get(index)) {
            index += 1;
        }
        if index >= length {
            return false
        }
        let quote = tag.byte_get(index);
        let value_start = if quote == b'"' || quote == b'\'' {
            index += 1;
            index
        } else {
            index
        };
        if quote == b'"' || quote == b'\'' {
            while index < length && tag.byte_get(index) != quote {
                index += 1;
            }
        } else {
            while index < length && !html_space(tag.byte_get(index)) && tag.byte_get(index) != b'>' {
                index += 1;
            }
        }
        if url_attribute(attribute) && !safe_url(tag.byte_slice(value_start, index)) {
            return false
        }
        if quote == b'"' || quote == b'\'' {
            index += 1;
        }
    }
    true
}

fn url_component(value: string, limit: isize, source: Source, offset: isize) -> Result[
    string,
    Error,
] {
    let output = Output::new(limit);
    let digits = b"0123456789ABCDEF";
    for byte in value.to_bytes() {
        if (byte >= b'A' && byte <= b'Z') || (byte >= b'a' && byte <= b'z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'-'
            || byte == b'.'
            || byte == b'_'
            || byte == b'~' {
            output.append(char_from_u32(byte.to_u32()).unwrap_or('?').to_string(), source, offset)?;
        } else {
            let upper = digits[(byte / 16).to_isize()];
            let lower = digits[(byte % 16).to_isize()];
            output.append("%", source, offset)?;
            output.append(char_from_u32(upper.to_u32()).unwrap_or('?').to_string(), source, offset)?;
            output.append(char_from_u32(lower.to_u32()).unwrap_or('?').to_string(), source, offset)?;
        }
    }
    Result::Ok(output.finish())
}

fn attribute_escape(value: string, bare: bool, limit: isize, source: Source, offset: isize) -> Result[
    string,
    Error,
] {
    let output = Output::new(limit);
    for scalar in value.chars() {
        output.append(
            match scalar {
                '&' => "&amp;",
                '<' => "&lt;",
                '>' => "&gt;",
                '"' => "&#34;",
                '\'' => "&#39;",
                '`' => "&#96;",
                '=' => if bare {
                    "&#61;"
                } else {
                    "="
                },
                _ => if bare && unicode::is_whitespace(scalar) {
                    "&#32;"
                } else {
                    scalar.to_string()
                },
            },
            source,
            offset,
        )?;
    }
    Result::Ok(output.finish())
}

fn script_escape(value: string, limit: isize, source: Source, offset: isize) -> Result[
    string,
    Error,
] {
    let output = Output::new(limit);
    for scalar in value.chars() {
        output.append(
            match scalar {
                '<' => "\\u003c",
                '>' => "\\u003e",
                '&' => "\\u0026",
                '/' => "\\u002f",
                _ => if scalar.to_u32() == 0x2028 {
                    "\\u2028"
                } else if scalar.to_u32() == 0x2029 {
                    "\\u2029"
                } else {
                    scalar.to_string()
                },
            },
            source,
            offset,
        )?;
    }
    Result::Ok(output.finish())
}

fn hex_scalar(value: u32) -> string {
    let digits = b"0123456789abcdef";
    let mut remaining = value;
    let mut result = "";
    loop {
        let digit = digits[(remaining % 16).to_isize()];
        result = char_from_u32(digit.to_u32()).unwrap_or('?').to_string() + result;
        remaining /= 16;
        if remaining == 0 {
            return result
        }
    }
}

fn style_escape(value: string, limit: isize, source: Source, offset: isize) -> Result[string, Error] {
    let output = Output::new(limit);
    output.append("\"", source, offset)?;
    for scalar in value.chars() {
        let code = scalar.to_u32();
        if scalar == '"' || scalar == '\'' || scalar == '\\' || scalar == '<' || scalar == '>'
            || scalar == '/'
            || code < 32
            || code == 127 {
            output.append("\\" + hex_scalar(code) + " ", source, offset)?;
        } else {
            output.append(scalar.to_string(), source, offset)?;
        }
    }
    output.append("\"", source, offset)?;
    Result::Ok(output.finish())
}

impl Output {
    fn append_literal(self: Output, literal: string, source: Source, offset: isize) -> Result[
        (),
        Error,
    ] {
        if let Some(context) = self.html {
            context.set(context.get().feed(literal, self.limit, source, offset)?);
        }
        self.append(literal, source, offset)
    }

    fn append_contextual(
        self: Output,
        value: Value,
        text: string,
        runtime: Runtime,
        source: Source,
        offset: isize,
    ) -> Result[(), Error] {
        let context = self.html.unwrap_or(Ref::new(HtmlContext::new()));
        let state = context.get();
        let escaped = match state.mode {
            0 => escaped(text, self.limit, source, offset)?,
            1 => {
                let tag = string_from_utf8(state.tag.copy()).1;
                let slot = html_slot(tag).or_error(
                    || problem(
                        source,
                        offset,
                        ErrorKind::Type,
                        "dynamic HTML tag or attribute name is unsupported",
                    ),
                )?;
                if slot.attribute.starts_with("on") || slot.attribute == "style"
                    || slot.attribute == "srcset"
                    || slot.attribute == "srcdoc"
                    || slot.attribute == "http-equiv"
                    || slot.attribute == "content" {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Type,
                            "dynamic active-content attribute is unsupported",
                        ),
                    )
                }
                let content = if url_attribute(slot.attribute) {
                    if !safe_url(slot.prefix) {
                        return Result::Err(
                            problem(source, offset, ErrorKind::Type, "unsafe URL prefix"),
                        )
                    }
                    if slot.prefix == "" {
                        if !safe_url(text) {
                            return Result::Err(
                                problem(source, offset, ErrorKind::Type, "unsafe URL value"),
                            )
                        }
                        text
                    } else {
                        url_component(text, self.limit, source, offset)?
                    }
                } else {
                    text
                };
                let result = attribute_escape(content, slot.bare, self.limit, source, offset)?;
                let marker = if url_attribute(slot.attribute) {
                    result
                } else {
                    "x"
                };
                let next = state;
                for byte in marker.to_bytes() {
                    next.tag.push(byte);
                }
                context.set(next);
                result
            },
            2 => return Result::Err(
                problem(source, offset, ErrorKind::Type, "dynamic HTML comment is unsupported"),
            ),
            3 => {
                if state.raw_quote != 0 || state.raw_comment != 0 {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Type,
                            "dynamic JavaScript string or comment is unsupported",
                        ),
                    )
                }
                script_escape(
                    json_text(value, runtime, source, offset)?,
                    self.limit,
                    source,
                    offset,
                )?
            },
            _ => {
                if state.raw_quote != 0 || state.raw_comment != 0 {
                    return Result::Err(
                        problem(
                            source,
                            offset,
                            ErrorKind::Type,
                            "dynamic CSS string or comment is unsupported",
                        ),
                    )
                }
                style_escape(text, self.limit, source, offset)?
            },
        };
        self.append(escaped, source, offset)
    }

    fn finish_html(self: Output, source: Source) -> Result[(), Error] {
        if let Some(context) = self.html {
            if context.get().mode != 0 {
                return Result::Err(
                    problem(
                        source,
                        source.text.byte_len(),
                        ErrorKind::Syntax,
                        "unfinished HTML context",
                    ),
                )
            }
        }
        Result::Ok(())
    }
}
